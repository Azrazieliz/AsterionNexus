{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus durable job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "job_id",
    "kind",
    "state",
    "idempotency_key"
  ],
  "properties": {
    "contract_version": {
      "const": "asterion.job.v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "enum": [
        "ACQUISITION",
        "CLOUD_TRANSFER",
        "INDEX",
        "FUSION",
        "TRANSLATION",
        "VIDEO_ASSEMBLY",
        "VIDEO_EDIT",
        "FILE_REPAIR",
        "ARCHIVE",
        "INTEGRATION",
        "MIGRATION"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "SPECIFIED",
        "QUEUED",
        "RUNNING",
        "WAITING_FOR_USER",
        "PAUSED",
        "PARTIAL",
        "VERIFIED",
        "FAILED",
        "CANCELLED",
        "UNSUPPORTED",
        "PERMISSION_DENIED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_asset_refs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Nexus asset reference v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nexus_id"
        ],
        "properties": {
          "nexus_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "NEXUS",
              "SAF",
              "MEDIASTORE",
              "TERABOX",
              "OTHER_CLOUD",
              "EXTERNAL_PARTNER"
            ]
          },
          "account_namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "location_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "media_kind": {
            "type": "string"
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "owner_lease": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "completed_steps": {
      "type": "integer",
      "minimum": 0
    },
    "total_steps": {
      "type": "integer",
      "minimum": 0
    },
    "output_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "failure_code": {
      "type": "string"
    },
    "cancellation_requested": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
