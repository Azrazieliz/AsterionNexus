<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.asterion.nexus.permission.REQUEST_ASTERION_DOWNLOAD"
        android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility is needed to validate the installed peer certificate
         on Android 11+. Unknown apps still fail the UID/approval check. -->
    <queries>
        <package android:name="com.azrael.pixivdumpsync"/>
        <package android:name="com.asterion.control"/>
        <package android:name="com.asterion.art"/>
        <package android:name="com.ailm.android"/>
        <package android:name="com.gamepilot"/>
    </queries>

    <application
        android:name=".AsterionApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_asterion_nexus"
        android:roundIcon="@drawable/ic_asterion_nexus"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- One private, data-free authority for durable transfer-state
             invalidations across existing downloader processes. -->
        <provider android:name=".DownloadStateSignalProvider"
            android:authorities="${applicationId}.download-events"
            android:exported="false"
            android:grantUriPermissions="false"/>
        <!-- Opt-in signed/UID-checked Control diagnostics. No arbitrary
             ContentProvider reads, writable files, or implicit authorization. -->
        <provider android:name=".AsterionControlDiagnosticsProvider"
            android:authorities="${applicationId}.asterion.diagnostics"
            android:exported="true"
            android:grantUriPermissions="false"/>
        <!-- Control native v1: original-owner signing identity is checked on
             every Binder call; exact app status and sanitized queue receipts.
             Legacy diagnostic adapter retains its separate authority above. -->
        <provider
            android:name="com.asterion.bridge.AsterionControlBridgeProvider"
            android:authorities="${applicationId}.asterion.bridge"
            android:exported="true"
            android:grantUriPermissions="false"/>
        <!-- Receiver authenticates OS caller UID and installed signing certificate,
             then requires per-peer user approval for independent Asterion keys. -->
        <!-- Dedicated, non-exported process keeps STOP responsive during a
             main-process ANR. It cancels only this application's backfill. -->
        <receiver android:name=".EmergencyBackfillStopReceiver"
            android:exported="false"
            android:process=":emergency"/>
        <receiver android:name=".RounderDownloadCompleteReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE"/>
            </intent-filter>
        </receiver>
        <receiver android:name=".AsterionDownloadRequestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.asterion.nexus.action.DOWNLOAD_REQUEST" />
            </intent-filter>
        </receiver>
        <service android:name=".AsterionDownloadJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <activity android:name=".ArchivebateWatchActivity"
            android:exported="false" />
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".FollowingActivity" android:exported="false" />
        <activity android:name=".XFollowingImportActivity" android:exported="false" />
        <activity android:name=".XMediaCaptureActivity" android:exported="false" />
        <activity android:name=".KoikatsuCardActivity" android:exported="false" />
        <activity android:name=".AssetMarketplaceActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name="com.azrael.galleryflow.MainActivity" android:exported="false" />
        <activity android:name="com.azrael.galleryflow.SiteLoginActivity" android:exported="false" />
        <activity android:name="com.azrael.galleryflow.ProviderWebActivity" android:exported="false" />
        <activity android:name="com.azrael.galleryflow.GalleryDetailActivity" android:exported="false" />
        <activity android:name="com.asterion.videoflow.MainActivity"
            android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".DownloaderHubActivity" android:exported="false"/>
        <activity android:name=".OfflineVnActivity" android:exported="false" />
        <!-- Main-process private cookie handoff to this app's isolated VideoFlow
             services. Not exported; no other application can read sessions. -->
        <provider android:name="com.azrael.galleryflow.SessionCookieProvider"
            android:authorities="${applicationId}.session-cookies"
            android:exported="false" />
        <provider android:name=".AsterionUpdateFileProvider"
            android:authorities="${applicationId}.update-apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider android:name=".TorrentDescriptorProvider"
            android:authorities="${applicationId}.torrent-files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity android:name="com.asterion.nexus.NexusPremiumHomeActivity"
            android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name="com.asterion.nexus.NexusLibraryActivity"
            android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.asterion.nexus.NexusPlaybackActivity"
            android:exported="false"/>
        <activity android:name="com.asterion.nexus.NexusCloudActivity"
            android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.asterion.nexus.NexusSearchActivity"
            android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.asterion.nexus.NexusSourcesActivity"
            android:exported="false"/>
        <activity android:name="com.asterion.nexus.NexusSafBrowserActivity"
            android:exported="false"/>
        <activity android:name="com.asterion.nexus.NexusFusionActivity"
            android:exported="false"/>
        <activity android:name="com.asterion.nexus.NexusCoreActivity"
            android:exported="false"/>
        <activity android:name="com.asterion.nexus.NexusReaderActivity"
            android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.asterion.nexus.NexusRounderPlaybackActivity"
            android:exported="false" android:configChanges="orientation|screenSize"/>
        <!-- One distinct authority; never claim or disturb the installed Rounder provider. -->
        <provider android:name="com.openlocal.office.core.FgTeraboxDocumentsProvider"
            android:authorities="com.asterion.nexus.terabox.documents"
            android:process=":terabox"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:exported="true" android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
            </intent-filter>
        </provider>

        <provider android:name="com.asterion.nexus.NexusLibraryProvider"
            android:authorities="${applicationId}.library"
            android:exported="false" android:grantUriPermissions="true"/>
        <activity android:name=".AsterionHomeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <service android:name=".DirectRetryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".RounderJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".KoikatsuFollowJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".SiteRunJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".SourceIndexJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".NovelEpubJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".Mp4VolumeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".Mp4SeriesJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".TorrentFeedJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".CreatorArchiveJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".TorrentTransferService" android:exported="false"
            android:process=":torrent"
            android:foregroundServiceType="dataSync" android:stopWithTask="false"/>
        <service android:name=".XPhotoService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".XPhotoJob" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".ChapterArchiveJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".ChapterArchiveService"
            android:exported="false" android:foregroundServiceType="dataSync"
            android:stopWithTask="false"/>
        <service android:name=".ChapterRecoveryService"
            android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE"/>
        <!-- Targeted in-app IPC; process-local downloader futures must be
             interrupted where they actually run, not in the UI process. -->
        <receiver android:name="com.asterion.videoflow.VideoCancelPrimaryReceiver"
            android:exported="false" android:process=":videoflow_primary"/>
        <receiver android:name="com.asterion.videoflow.VideoCancelSecondaryReceiver"
            android:exported="false" android:process=":videoflow_secondary"/>
        <service android:name="com.asterion.videoflow.TransferService"
            android:exported="false" android:process=":videoflow_primary"
            android:foregroundServiceType="dataSync" android:stopWithTask="false"/>
        <service android:name="com.asterion.videoflow.TransferAgentTwoService"
            android:exported="false" android:process=":videoflow_secondary"
            android:foregroundServiceType="dataSync" android:stopWithTask="false"/>
        <service android:name="com.asterion.videoflow.PollJobService"
            android:exported="true" android:process=":videoflow_primary"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name="com.asterion.videoflow.SecondaryPollJobService"
            android:exported="true" android:process=":videoflow_secondary"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <!-- One restore receiver only: defer all module scheduling to the
             existing RestoreDownloadSchedulesJob, never heavy boot IPC. -->
        <service android:name=".NduCloudJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".NduUploadService"
            android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name="com.azrael.galleryflow.SyncForegroundService"
            android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name="com.azrael.galleryflow.SyncJobService"
            android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".SyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Boot restoration is a deferred JobService. No provider sync or
             Python initialization may occupy the BOOT_COMPLETED broadcast. -->
        <service android:name="com.asterion.nexus.NexusBookIndexJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <service android:name=".RestoreDownloadSchedulesJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
